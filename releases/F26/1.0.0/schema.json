      "colCount": 8,
      "demoRowsCount": 2
    },
    {
      "name": "Settings",
      "headers": [
        "Key",
        "Value",
        "Description",
        "CreatedAt",
        "UpdatedAt",
        "CreatedBy",
        "RowVersion",
        "Archived"
      ],
      "colCount": 8,
      "demoRowsCount": 2
    }
