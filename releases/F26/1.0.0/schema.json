        "ID",
        "StudentCode",
        "FullName",
        "GuardianName",
        "GuardianPhone",
        "Email",
        "CreatedAt",
        "UpdatedAt",
        "CreatedBy",
        "RowVersion",
        "Archived"
      ],
      "colCount": 11,
      "demoRowsCount": 3
    },
    {
      "name": "Classes",
      "headers": [
        "ID",
        "ClassCode",
        "Name",
        "TeacherEmail",
        "StartDate",
        "EndDate",
        "FeePerSession",
        "ScheduleDays",
        "Active",
        "CreatedAt",
        "UpdatedAt",
        "CreatedBy",
        "RowVersion",
        "Archived"
      ],
      "colCount": 14,
      "demoRowsCount": 2
    },
    {
      "name": "Enrollments",
      "headers": [
        "ID",
        "StudentID",
        "ClassID",
        "EnrolledAt",
        "Status",
        "TotalCreditSessions",
