        "RemainingSessions",
        "CreatedAt",
        "UpdatedAt",
        "CreatedBy",
        "RowVersion",
        "Archived"
      ],
      "colCount": 13,
      "demoRowsCount": 3
    },
    {
      "name": "Sessions",
      "headers": [
        "ID",
        "ClassID",
        "SessionDate",
        "StartTime",
        "EndTime",
