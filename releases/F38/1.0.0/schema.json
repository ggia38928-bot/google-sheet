    {
      "name": "WorkCalendar",
      "headers": [
        "ID",
        "Date",
        "DayOfWeek",
        "IsWorkingDay",
        "Notes",
        "CreatedAt",
        "UpdatedAt",
        "CreatedBy",
        "RowVersion",
        "Archived"
      ],
      "colCount": 10,
      "demoRowsCount": 4
    },
    {
      "name": "LeaveApprovals",
      "headers": [
        "ID",
        "RequestID",
        "ApproverEmail",
        "Decision",
        "DecisionAt",
        "Comment",
        "CreatedAt",
        "UpdatedAt",
        "CreatedBy",
        "RowVersion",
