        "Người thực hiện"
      ],
      "colCount": 6,
      "demoRowsCount": 2
    },
    {
      "name": "REPORT_ADJUSTMENTS",
      "headers": [
        "Mã điều chỉnh",
        "Kỳ kế toán",
        "Mã tài khoản",
        "Số tiền điều chỉnh (VND)",
        "Lý do điều chỉnh",
        "Trạng thái"
      ],
      "colCount": 6,
      "demoRowsCount": 1
    }
